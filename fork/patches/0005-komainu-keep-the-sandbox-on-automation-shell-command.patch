From da2d471cdb24683c74c32b211b0feca40924e465 Mon Sep 17 00:00:00 2001
From: carlmasters02 <169651373+carlmasters02@users.noreply.github.com>
Date: Tue, 24 Nov 2026 04:30:16 +0000
Subject: [PATCH] komainu: keep the sandbox on automation shell commands

Automation shell runs reset the command to the stored text after the shell create.before hooks, which threw away the plugin's OS-sandbox wrapping, so every shell automation ran unsandboxed. The stored command is still what runs, but plugins can now wrap it; the working directory, shell and timeout stay fixed. Adds a regression test.
---
 packages/core/src/automation/shell.ts       |  4 +-
 packages/core/test/automation-shell.test.ts | 44 +++++++++++++++++++++
 2 files changed, 46 insertions(+), 2 deletions(-)

diff --git a/packages/core/src/automation/shell.ts b/packages/core/src/automation/shell.ts
index d1ae10e..9b67354 100644
--- a/packages/core/src/automation/shell.ts
+++ b/packages/core/src/automation/shell.ts
@@ -71,8 +71,8 @@ export const start = Effect.fnUntraced(function* (
     { command: action.command, cwd: directory, shell: program, metadata: { sessionID: owner.id } },
     (input) =>
       Effect.sync(() => {
-        // Hooks can set the environment, but the stored command and its working directory are fixed.
-        input.command = action.command
+        // Hooks can set the environment and wrap the stored command (Komainu runs it inside its OS sandbox this way),
+        // but its working directory, shell and timeout are fixed.
         input.cwd = directory
         input.shell = program
         input.timeout = 0
diff --git a/packages/core/test/automation-shell.test.ts b/packages/core/test/automation-shell.test.ts
index e3efb3a..6914af4 100644
--- a/packages/core/test/automation-shell.test.ts
+++ b/packages/core/test/automation-shell.test.ts
@@ -171,6 +171,50 @@ it.live("uses the saved location after the creating session moves and pauses if
   }),
 )
 
+it.live("keeps a plugin's create.before wrapping of the stored command (Komainu sandboxes it this way)", () =>
+  Effect.gen(function* () {
+    const directory = AbsolutePath.make((yield* tmpdirScoped()).path)
+    yield* Effect.promise(() => Bun.write(path.join(directory, "opencode.json"), JSON.stringify({ automations: true })))
+    const sessions = yield* Session.Service
+    const session = yield* sessions.create({
+      location: { directory },
+      permissions: [{ action: "shell", resource: "*", effect: "allow" }],
+    })
+    const automations = yield* Automation.Service
+    const created = yield* automations.create({
+      name: "wrapped",
+      sessionID: session.id,
+      trigger,
+      action: { type: "shell", command: "echo automation-output" },
+    })
+    const instances = yield* Instance.Service
+    yield* Effect.gen(function* () {
+      const hooks = yield* PluginHooks.Service
+      yield* hooks.register("shell", "create.before", (input) =>
+        Effect.sync(() => {
+          input.command = `echo sandbox-wrapper && ${input.command}`
+        }),
+      )
+    }).pipe(instances.provide(session))
+    const database = yield* Database.Service
+    yield* database.db
+      .update(AutomationTable)
+      .set({ next_due_at: yield* Clock.currentTimeMillis })
+      .where(eq(AutomationTable.id, created.id))
+      .run()
+    yield* automations.tick
+    const ran = yield* automations
+      .get(created.id)
+      .pipe(
+        Effect.repeat({ until: (row) => row.lastOutput !== undefined, schedule: Schedule.spaced("10 millis") }),
+        Effect.timeout("10 seconds"),
+      )
+    expect(ran).toMatchObject({ lastOutcome: "fired" })
+    expect(ran.lastOutput).toContain("sandbox-wrapper")
+    expect(ran.lastOutput).toContain("automation-output")
+  }),
+)
+
 it.live("rejects a shell action that changes to a denied external directory", () =>
   Effect.gen(function* () {
     const directory = AbsolutePath.make((yield* tmpdirScoped()).path)
