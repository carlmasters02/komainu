           </For>
-          <For each={logo.right}>
+          <For each={wordmark.right}>
             {(line) => <box flexDirection="row">{renderLine(line, theme.text.base, true)}</box>}
           </For>
         </>
       ) : (
-        <For each={logo.left}>
+        <For each={mark().left}>
